KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=bluesky-posts

HBASE_REST_URL=http://hbase:8080

# Spark Structured Streaming window/slide/watermark
WINDOW_DURATION=5 minutes
SLIDE_DURATION=1 minute
WATERMARK_DELAY=2 minutes
# Posts self-report their timestamp (Bluesky's createdAt) - reject anything
# claiming to be more than this many seconds in the future, so one
# clock-skewed client can't permanently jump the watermark forward
MAX_FUTURE_SKEW_SECONDS=120

# Filters to avoid junk trends
MIN_COUNT_THRESHOLD=3
MIN_DISTINCT_AUTHORS=2
MIN_TERM_LENGTH=3

# score = current_window_count / (baseline_avg + TREND_SMOOTHING)
TREND_SMOOTHING=1.0
# weight given to the newest window when updating each term's trailing baseline
BASELINE_EMA_ALPHA=0.3

TOP_N=20
RETENTION_HOURS=24
CHECKPOINT_DIR=/checkpoints/trending

TABLE_TRENDS=trends
TABLE_TERM_HISTORY=term_history
TABLE_BASELINE=term_baseline
TABLE_META=pipeline_meta
