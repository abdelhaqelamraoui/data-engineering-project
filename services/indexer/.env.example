KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=bluesky-posts
# Unlike api's live-feed consumer (which never commits and starts at
# "latest" on every restart), this one uses a stable group with committed
# offsets - it's building a durable searchable archive, so a restart should
# resume where it left off rather than skip or replay everything.
CONSUMER_GROUP_ID=indexer

ELASTICSEARCH_URL=http://elasticsearch:9200
ES_INDEX=bluesky-posts
# used once at startup to auto-create a matching Kibana data view; safe to
# leave as-is even if Kibana isn't deployed - failures here are non-fatal
KIBANA_URL=http://kibana:5601

# must match spark-processor's MIN_TERM_LENGTH so indexed terms match what
# the scoring pipeline actually extracts
MIN_TERM_LENGTH=3

# bulk-index every N documents or every T seconds, whichever comes first
BULK_FLUSH_SIZE=200
BULK_FLUSH_INTERVAL_SECONDS=5

LOG_LEVEL=INFO
