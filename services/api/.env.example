HBASE_REST_URL=http://hbase:8080

TABLE_TRENDS=trends
TABLE_TERM_HISTORY=term_history
TABLE_BASELINE=term_baseline
TABLE_META=pipeline_meta

TOP_N_DEFAULT=20

# Comma-separated list of allowed dashboard origins
CORS_ORIGINS=http://localhost:3000

# Live posts feed - independent read of the same raw topic the Spark job consumes
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=bluesky-posts
LIVE_POSTS_BUFFER_SIZE=200
