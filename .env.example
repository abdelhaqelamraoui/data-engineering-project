# Shared docker-compose variables (host ports, cluster identity).
# Per-service runtime config lives in services/*/.env instead.

# Generate your own with:
#   docker run --rm apache/kafka:3.7.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=changeme-generate-a-uuid
KAFKA_TOPIC=bluesky-posts

HBASE_MASTER_UI_PORT=16010
HBASE_REST_PORT=8080
API_PORT=8000
DASHBOARD_PORT=3000
